/* pages/class/class.wxss */

.class-page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 30rpx;
}

/* ===== 加入班级区域 ===== */
.join-section {
  display: flex;
  justify-content: center;
  padding-top: 100rpx;
}

.join-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.join-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-top: 30rpx;
}

.join-tip {
  font-size: 26rpx;
  color: #999999;
  margin-top: 16rpx;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.code-input {
  width: 100%;
}

/* ===== 班级信息区域 ===== */
.class-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.class-info-card {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  color: #ffffff;
}

.class-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.class-name {
  font-size: 36rpx;
  font-weight: bold;
}

.class-school {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 30rpx;
  display: block;
}

.class-stats {
  display: flex;
  gap: 60rpx;
}

.class-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

/* ===== 排行榜 ===== */
.ranking-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin: 20rpx 0 10rpx 10rpx;
}

.ranking-list {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-me {
  background: #f0fdf4;
  border-radius: 12rpx;
  margin: 0 -10rpx;
  padding: 24rpx 20rpx;
}

.rank-num {
  width: 60rpx;
  text-align: center;
}

.rank-1, .rank-2, .rank-3 {
  font-size: 40rpx;
}

.rank-normal {
  font-size: 30rpx;
  color: #999999;
  font-weight: 600;
}

.rank-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
}

.rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.rank-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.rank-detail {
  font-size: 22rpx;
  color: #999999;
}

.rank-score {
  font-size: 32rpx;
  font-weight: bold;
  color: #F59E0B;
}

/* 退出班级按钮 */
.leave-btn {
  margin-top: 30rpx !important;
  color: #EF4444 !important;
  border-color: #EF4444 !important;
}

/* 加载 */
.loading-box {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
}