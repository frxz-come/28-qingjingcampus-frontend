/* pages/class/class.wxss */
.class-page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 30rpx;
  position: relative;
}

/* ===== 加入班级区域 ===== */
.join-section {
  display: flex;
  justify-content: center;
  padding-top: 100rpx;
}

.join-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.join-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
}

.join-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-top: 30rpx;
}

.join-tip {
  font-size: 26rpx;
  color: #999999;
  margin-top: 16rpx;
  margin-bottom: 40rpx;
  line-height: 1.5;
}

.code-input {
  width: 100%;
}

/* ===== 班级信息区域 ===== */
.class-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.class-info-card {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  color: #ffffff;
}

.class-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.class-name {
  font-size: 36rpx;
  font-weight: bold;
}

.class-school {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 30rpx;
  display: block;
}

.class-stats {
  display: flex;
  gap: 60rpx;
}

.class-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

/* ===== 排行榜 ===== */
.ranking-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin: 20rpx 0 10rpx 10rpx;
}

.ranking-list {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-me {
  background: #f0fdf4;
  border-radius: 12rpx;
  margin: 0 -10rpx;
  padding: 24rpx 20rpx;
}

.rank-num {
  width: 60rpx;
  text-align: center;
}

.rank-1, .rank-2, .rank-3 {
  font-size: 40rpx;
}

.rank-normal {
  font-size: 30rpx;
  color: #999999;
  font-weight: 600;
}

.rank-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #e0e0e0;
}

.rank-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.rank-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.rank-detail {
  font-size: 22rpx;
  color: #999999;
}

.rank-score {
  font-size: 32rpx;
  font-weight: bold;
  color: #F59E0B;
}

/* 退出班级按钮 */
.leave-btn {
  margin-top: 30rpx !important;
  color: #EF4444 !important;
  border-color: #EF4444 !important;
}

/* ===== 全局加载 - 四分类轮转 ===== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  z-index: 999;
}

.loading-circle-large {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 12rpx 48rpx rgba(16, 185, 129, 0.35);
  animation: circleBreathLarge 2s ease-in-out infinite;
}

@keyframes circleBreathLarge {
  0%, 100% { transform: scale(1); box-shadow: 0 12rpx 48rpx rgba(16, 185, 129, 0.35); }
  50% { transform: scale(1.05); box-shadow: 0 16rpx 56rpx rgba(16, 185, 129, 0.5); }
}

.trash-wrap-large {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trash-icon-large {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  opacity: 0;
  animation: iconSwitchLarge 3s ease-in-out infinite;
}

.icon-1 { animation-delay: 0s; }
.icon-2 { animation-delay: 0.75s; }
.icon-3 { animation-delay: 1.5s; }
.icon-4 { animation-delay: 2.25s; }

@keyframes iconSwitchLarge {
  0% { opacity: 0; transform: scale(0.5) rotate(-10deg); }
  10% { opacity: 1; transform: scale(1.1) rotate(0deg); }
  20% { opacity: 1; transform: scale(1) rotate(0deg); }
  30% { opacity: 0; transform: scale(0.8) rotate(10deg); }
  100% { opacity: 0; transform: scale(0.5) rotate(-10deg); }
}

.loading-text-large {
  font-size: 36rpx;
  color: #059669;
  letter-spacing: 8rpx;
  font-weight: 500;
}