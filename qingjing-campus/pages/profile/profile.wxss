/* pages/profile/profile.wxss */

.profile-page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

/* ========== 顶部用户信息 ========== */
.user-header {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  padding: 60rpx 40rpx 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #ffffff;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
}

/* 头像按钮 —— 彻底去掉所有默认样式 */
.avatar-btn {
  position: relative;
  background: none !important;
  border: none !important;
  padding: 0 !important;
  margin: 0 0 20rpx 0 !important;
  line-height: inherit !important;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
}

.avatar-btn::after {
  border: none !important;
  background: none !important;
  box-shadow: none !important;
}

.avatar-btn.button-hover {
  background: none !important;
  box-shadow: none !important;
}

/* 头像外层容器：负责圆形裁剪 */
.avatar-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 默认头像状态 */
.avatar-default {
  background-color: rgba(255, 255, 255, 0.3);
}

/* 实际图片：填满容器，不做 border-radius */
.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

/* 加载中状态 */
.avatar-loading {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.1);
}

/* 编辑角标已删除，相关样式移除 */

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.name {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.phone {
  font-size: 26rpx;
  opacity: 0.9;
}

.phone.unbind {
  opacity: 0.6;
}

/* ========== 数据统计 ========== */
.stats-row {
  display: flex;
  justify-content: space-around;
  margin: -40rpx 30rpx 30rpx 30rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #10B981;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

/* ========== 功能列表 ========== */
.menu-section {
  margin: 0 20rpx 30rpx 20rpx;
}

/* ========== 编辑弹窗 ========== */
.edit-popup {
  padding: 40rpx 30rpx 60rpx 30rpx;
}

.edit-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #333333;
}

.edit-btns {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 30rpx;
  padding: 0 20rpx;
}

/* ========== 退出/注销 ========== */
.logout-section {
  margin: 40rpx 40rpx 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.logout-btn {
  color: #EF4444 !important;
  border-color: #EF4444 !important;
}

.cancel-btn {
  color: #999999 !important;
  border-color: #cccccc !important;
}
