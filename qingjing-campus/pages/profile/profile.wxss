/* ===== 页面根节点 ===== */
page {
  background: linear-gradient(180deg, #10B981 0%, #34D399 25vh, #6EE7B7 50vh, #D1FAE5 75vh, #f5f7fa 100%);
  min-height: 100vh;
}

.profile-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ========== 顶部用户信息 ========== */
.user-header {
  background: transparent;
  padding: 40rpx 40rpx 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #ffffff;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  flex-shrink: 0;
}

/* 头像按钮 */
.avatar-btn {
  position: relative;
  background: none !important;
  border: none !important;
  padding: 0 !important;
  margin: 0 0 16rpx 0 !important;
  line-height: inherit !important;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
}

.avatar-btn::after {
  border: none !important;
  background: none !important;
  box-shadow: none !important;
}

.avatar-btn.button-hover {
  background: none !important;
  box-shadow: none !important;
}

.avatar-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-default {
  background-color: rgba(255, 255, 255, 0.3);
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-loading {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.1);
}

.nickname {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 6rpx;
}

.name {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 6rpx;
}

.phone {
  font-size: 24rpx;
  opacity: 0.9;
}

.phone.unbind {
  opacity: 0.6;
}

/* ========== 数据统计 ========== */
.stats-row {
  display: flex;
  justify-content: space-around;
  margin: -30rpx 30rpx 20rpx 30rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
  flex-shrink: 0;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #10B981;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

/* ========== 功能列表 ========== */
.menu-section {
  margin: 0 20rpx 20rpx 20rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

/* 让菜单项撑满剩余空间 */
.menu-section van-cell-group {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.menu-section van-cell {
  flex: 1;
}

/* ========== 退出/注销 ========== */
.logout-section {
  margin: 0 40rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex-shrink: 0;
}

.logout-btn {
  color: #EF4444 !important;
  border-color: #EF4444 !important;
}

.cancel-btn {
  color: #999999 !important;
  border-color: #cccccc !important;
}

/* ========== 编辑弹窗 ========== */
.edit-popup {
  padding: 40rpx 30rpx 60rpx 30rpx;
}

.edit-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #333333;
}

.edit-btns {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 30rpx;
  padding: 0 20rpx;
}

/* ========== 换绑手机号弹窗样式 ========== */
.phone-popup {
  padding: 40rpx 30rpx 60rpx 30rpx;
}

.phone-popup-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 16rpx;
  color: #333333;
}

.phone-popup-subtitle {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  margin-bottom: 30rpx;
}

.phone-popup-btns {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 40rpx;
  padding: 0 20rpx;
}

/* ========== 全局加载 ========== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  z-index: 999;
}

.loading-circle-large {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 12rpx 48rpx rgba(16, 185, 129, 0.35);
  animation: circleBreathLarge 2s ease-in-out infinite;
}

@keyframes circleBreathLarge {
  0%, 100% { transform: scale(1); box-shadow: 0 12rpx 48rpx rgba(16, 185, 129, 0.35); }
  50% { transform: scale(1.05); box-shadow: 0 16rpx 56rpx rgba(16, 185, 129, 0.5); }
}

.trash-wrap-large {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trash-icon-large {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  opacity: 0;
  animation: iconSwitchLarge 3s ease-in-out infinite;
}

.icon-1 { animation-delay: 0s; }
.icon-2 { animation-delay: 0.75s; }
.icon-3 { animation-delay: 1.5s; }
.icon-4 { animation-delay: 2.25s; }

@keyframes iconSwitchLarge {
  0% { opacity: 0; transform: scale(0.5) rotate(-10deg); }
  10% { opacity: 1; transform: scale(1.1) rotate(0deg); }
  20% { opacity: 1; transform: scale(1) rotate(0deg); }
  30% { opacity: 0; transform: scale(0.8) rotate(10deg); }
  100% { opacity: 0; transform: scale(0.5) rotate(-10deg); }
}

.loading-text-large {
  font-size: 36rpx;
  color: #059669;
  letter-spacing: 8rpx;
  font-weight: 500;
}