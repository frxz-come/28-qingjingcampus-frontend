<!-- pages/learn/learn.wxml -->
<view class="learn-page">

<!-- ========== 概览页 ========== -->
<view wx:if="{{ pageState === 'overview' }}" class="overview-page">
  <!-- 顶部进度卡片 -->
  <view class="progress-header">
    <view class="progress-info">
      <text class="progress-title">我的学习进度</text>
      <text class="progress-num">{{ overview.studiedCardCount }} / {{ overview.totalCardCount }} 张</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{ overview.progressPercent }}%;"></view>
    </view>
  </view>

  <!-- 总体统计卡片 -->
  <view class="stats-card">
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-num">{{ overview.totalCardCount }}</text>
        <text class="stat-label">总卡片</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{ overview.studiedCardCount }}</text>
        <text class="stat-label">已学习</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{ overview.totalCardCount - overview.studiedCardCount }}</text>
        <text class="stat-label">待学习</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item highlight">
        <text class="stat-num">{{ overview.progressPercent }}%</text>
        <text class="stat-label">完成率</text>
      </view>
    </view>
  </view>

  <!-- 分类进度详情 -->
  <view class="section-title">
    <van-icon name="bar-chart-o" size="32rpx" color="#10B981" />
    <text>分类学习进度</text>
  </view>

  <!-- 可拉伸的分类列表区域 -->
  <view class="category-progress-list">
    <block wx:for="{{ overview.categories }}" wx:key="mainCategory">
      <view class="category-progress-item" bindtap="onCategoryTap" data-category="{{ item.mainCategory }}">
        <view class="cp-left">
          <view class="cp-icon" style="background: {{ item.mainCategory === '可回收物' ? '#DBEAFE' : item.mainCategory === '有害垃圾' ? '#FEE2E2' : item.mainCategory === '厨余垃圾' ? '#D1FAE5' : '#F3F4F6' }}">
            <text class="cp-icon-text" style="color: {{ item.mainCategory === '可回收物' ? '#1E90FF' : item.mainCategory === '有害垃圾' ? '#EF4444' : item.mainCategory === '厨余垃圾' ? '#10B981' : '#6B7280' }}">
              {{ item.mainCategory === '可回收物' ? '♻' : item.mainCategory === '有害垃圾' ? '☠' : item.mainCategory === '厨余垃圾' ? '🍃' : '🗑' }}
            </text>
          </view>
          <view class="cp-info">
            <text class="cp-name">{{ item.mainCategory }}</text>
            <view class="cp-mini-bar">
              <view class="cp-mini-fill" style="width: {{ item.progressPercent }}%; background: {{ item.mainCategory === '可回收物' ? '#1E90FF' : item.mainCategory === '有害垃圾' ? '#EF4444' : item.mainCategory === '厨余垃圾' ? '#10B981' : '#6B7280' }}"></view>
            </view>
          </view>
        </view>
        <view class="cp-right">
          <text class="cp-count">{{ item.studiedCount }}/{{ item.cardCount }}</text>
          <van-icon name="arrow" color="#cccccc" size="28rpx" />
        </view>
      </view>
    </block>
  </view>

  <!-- 开始学习按钮 -->
  <view class="start-learn-section">
    <van-button
      type="primary"
      block
      round
      color="linear-gradient(135deg, #10B981 0%, #059669 100%)"
      custom-class="start-btn"
      bindtap="startLearning"
    >
      <van-icon name="play-circle-o" size="36rpx" color="#ffffff" />
      <text>开始学习</text>
    </van-button>
  </view>
</view>

<!-- ========== 列表页 ========== -->
<view wx:if="{{ pageState === 'list' }}" class="list-page">
  <view class="nav-header">
    <van-icon name="arrow-left" size="40rpx" color="#333" bindtap="backToOverview" />
    <text class="nav-title">{{ currentCategory }}</text>
    <view style="width: 40rpx;"></view>
  </view>
  <scroll-view scroll-y class="card-list">
    <block wx:for="{{ cardList }}" wx:key="cardId">
      <view class="card-item {{ item.studied ? 'studied' : '' }}" bindtap="onCardTap" data-index="{{ index }}">
        <view class="card-thumb-wrap">
          <image
            class="card-thumb"
            src="{{ item.cardImage }}"
            mode="aspectFill"
            lazy-load="{{ true }}"
            binderror="onImageError"
            data-index="{{ index }}"
            data-type="card"
            data-src="{{ item.cardImage }}"
          />
        </view>
        <view class="card-info">
          <view class="card-title-row">
            <van-tag color="{{ item.studied ? '#10B981' : '#999' }}" text-color="#ffffff">{{ item.studied ? '已学' : '未学' }}</van-tag>
            <text class="card-title">{{ item.cardTitle }}</text>
          </view>
          <text class="card-sub">{{ item.subCategory }}</text>
        </view>
        <van-icon name="arrow" color="#ccc" />
      </view>
    </block>
  </scroll-view>
</view>

<!-- ========== 详情页 ========== -->
<view wx:if="{{ pageState === 'detail' }}" class="detail-page">
  <view class="nav-header">
    <van-icon name="arrow-left" size="40rpx" color="#333" bindtap="backToList" />
    <text class="nav-title">{{ currentCard.cardTitle }}</text>
    <view style="width: 40rpx;"></view>
  </view>
  <scroll-view scroll-y class="detail-scroll">
    <image
      class="detail-image"
      src="{{ currentCard.cardImage }}"
      mode="aspectFill"
      binderror="onImageError"
      data-type="detail"
      data-src="{{ currentCard.cardImage }}"
    />
    <view class="detail-tags">
      <van-tag color="{{ currentCard.mainCategory === '可回收物' ? '#1E90FF' : currentCard.mainCategory === '有害垃圾' ? '#EF4444' : currentCard.mainCategory === '厨余垃圾' ? '#10B981' : '#6B7280' }}" text-color="#ffffff" size="large">{{ currentCard.mainCategory }}</van-tag>
      <text class="detail-sub">{{ currentCard.subCategory }}</text>
    </view>
    <view class="detail-section" wx:if="{{ currentCard.commonExamples && currentCard.commonExamples.length > 0 }}">
      <view class="section-label">
        <van-icon name="label-o" size="32rpx" color="#10B981" />
        <text>常见举例</text>
      </view>
      <view class="examples-list">
        <block wx:for="{{ currentCard.commonExamples }}" wx:key="*this">
          <text class="example-tag">{{ item }}</text>
        </block>
      </view>
    </view>
    <view class="detail-section">
      <view class="section-label">
        <van-icon name="description-o" size="32rpx" color="#10B981" />
        <text>知识内容</text>
      </view>
      <text class="section-text">{{ currentCard.cardContent }}</text>
    </view>
    <view class="detail-section">
      <view class="section-label">
        <van-icon name="guide-o" size="32rpx" color="#10B981" />
        <text>投放要求</text>
      </view>
      <text class="section-text">{{ currentCard.disposalRequirement }}</text>
    </view>
    <view class="detail-section">
      <view class="section-label">
        <van-icon name="warning-o" size="32rpx" color="#10B981" />
        <text>注意事项</text>
      </view>
      <text class="section-text">{{ currentCard.precautions }}</text>
    </view>
  </scroll-view>
  <view class="detail-footer">
    <view class="nav-btns">
      <van-button type="default" size="small" disabled="{{ currentIndex === 0 }}" bindtap="prevCard">上一张</van-button>
      <text class="page-num">{{ currentIndex + 1 }} / {{ cardList.length }}</text>
      <van-button type="default" size="small" disabled="{{ currentIndex === cardList.length - 1 }}" bindtap="nextCard">下一张</van-button>
    </view>
    <van-button
      wx:if="{{ !currentCard.studied }}"
      type="primary"
      block
      round
      color="#10B981"
      bindtap="onMarkStudied"
      loading="{{ loading }}"
    >
      完成学习
    </van-button>
    <van-button
      wx:else
      type="default"
      block
      round
      disabled
    >
      <van-icon name="checked" size="32rpx" color="#10B981" />
      已完成学习
    </van-button>
  </view>
</view>

<!-- ========== 全局加载 - 四分类图标轮播 ========== -->
<view wx:if="{{ loading }}" class="loading-overlay">
  <view class="loading-circle-large">
    <view class="trash-wrap-large">
      <image class="trash-icon-large icon-1" src="/static/images/loading/recycle.png" mode="aspectFit" />
      <image class="trash-icon-large icon-2" src="/static/images/loading/harmful.png" mode="aspectFit" />
      <image class="trash-icon-large icon-3" src="/static/images/loading/kitchen.png" mode="aspectFit" />
      <image class="trash-icon-large icon-4" src="/static/images/loading/other.png" mode="aspectFit" />
    </view>
  </view>
  <text class="loading-text-large">加载中...</text>
</view>
</view>