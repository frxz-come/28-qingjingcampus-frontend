/* pages/learn/learn.wxss */
.learn-page {
  min-height: 100vh;
  background-color: #f5f7fa;
}

.overview-page {
  min-height: 100vh;
}

.progress-header {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  padding: 30rpx 40rpx;
  color: #ffffff;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-title {
  font-size: 32rpx;
  font-weight: bold;
}

.progress-num {
  font-size: 28rpx;
  opacity: 0.9;
}

.progress-bar {
  height: 12rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #ffffff;
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.progress-tip {
  display: block;
  font-size: 22rpx;
  margin-top: 12rpx;
  opacity: 0.8;
}

.category-grid {
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.category-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.category-cover {
  width: 100%;
  height: 240rpx;
  display: block;
}

.category-info {
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.category-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.category-count {
  font-size: 26rpx;
  color: #999999;
}

.category-progress {
  height: 6rpx;
  background: #f0f0f0;
  margin: 0 24rpx 20rpx 24rpx;
  border-radius: 3rpx;
  overflow: hidden;
}

.category-progress-fill {
  height: 100%;
  background: #10B981;
  border-radius: 3rpx;
  transition: width 0.5s ease;
}

.list-page {
  min-height: 100vh;
}

.nav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.card-list {
  height: calc(100vh - 88rpx);
  padding: 20rpx;
  box-sizing: border-box;
}

.card-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.card-item.studied {
  opacity: 0.7;
}

.card-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

.card-sub {
  font-size: 26rpx;
  color: #999999;
}

.detail-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.detail-scroll {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.detail-image {
  width: 100%;
  height: 400rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  background-color: #f0f0f0;
}

.detail-tags {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.detail-sub {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.detail-section {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.section-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
}

.examples-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.example-tag {
  background: #f0fdf4;
  color: #10B981;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.detail-footer {
  background: #ffffff;
  padding: 20rpx 30rpx 40rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.nav-btns {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.page-num {
  font-size: 28rpx;
  color: #999999;
}

.loading-box {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
}