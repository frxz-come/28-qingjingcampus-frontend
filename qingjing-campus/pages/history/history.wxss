/* pages/history/history.wxss */
.history-page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 20rpx;
  position: relative;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.history-item:active {
  background-color: #f9f9f9;
}

.history-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
}

.history-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.history-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-time {
  font-size: 22rpx;
  color: #999999;
}

.history-sub {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-top: 8rpx;
}

.history-bottom {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 8rpx;
}

.load-more {
  text-align: center;
  padding: 20rpx;
  color: #999999;
  font-size: 24rpx;
}

.no-more {
  text-align: center;
  padding: 20rpx;
  color: #999999;
  font-size: 24rpx;
}

.empty-btn {
  margin-top: 40rpx !important;
}

/* ========== 全局加载 - 四分类图标轮播（放大版）========== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  z-index: 999;
}

.loading-circle-large {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 12rpx 48rpx rgba(16, 185, 129, 0.35);
  animation: circleBreathLarge 2s ease-in-out infinite;
}

@keyframes circleBreathLarge {
  0%, 100% { transform: scale(1); box-shadow: 0 12rpx 48rpx rgba(16, 185, 129, 0.35); }
  50% { transform: scale(1.05); box-shadow: 0 16rpx 56rpx rgba(16, 185, 129, 0.5); }
}

.trash-wrap-large {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trash-icon-large {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  opacity: 0;
  animation: iconSwitchLarge 3s ease-in-out infinite;
}

.icon-1 { animation-delay: 0s; }
.icon-2 { animation-delay: 0.75s; }
.icon-3 { animation-delay: 1.5s; }
.icon-4 { animation-delay: 2.25s; }

@keyframes iconSwitchLarge {
  0% { opacity: 0; transform: scale(0.5) rotate(-10deg); }
  10% { opacity: 1; transform: scale(1.1) rotate(0deg); }
  20% { opacity: 1; transform: scale(1) rotate(0deg); }
  30% { opacity: 0; transform: scale(0.8) rotate(10deg); }
  100% { opacity: 0; transform: scale(0.5) rotate(-10deg); }
}

.loading-text-large {
  font-size: 36rpx;
  color: #059669;
  letter-spacing: 8rpx;
  font-weight: 500;
}