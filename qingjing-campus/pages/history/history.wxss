/* pages/history/history.wxss */

.history-page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 20rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.history-item:active {
  background-color: #f9f9f9;
}

.history-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background-color: #f0f0f0;
}

.history-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.history-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-time {
  font-size: 22rpx;
  color: #999999;
}

.history-sub {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-top: 8rpx;
}

.history-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}

.confidence {
  font-size: 24rpx;
  color: #666666;
}

.empty-btn {
  margin-top: 40rpx !important;
}