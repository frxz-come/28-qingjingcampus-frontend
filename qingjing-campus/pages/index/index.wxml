<!-- pages/index/index.wxml -->
<!-- v2.1: 优先展示 detectedImage（带框图），支持多目标列表，结果图片可点击放大预览 -->

<view class="scan-page">
  <!-- 全屏图片预览区域 -->
  <view class="preview-area">
    <image wx:if="{{ imageUrl }}" class="preview-image" src="{{ imageUrl }}" mode="aspectFit" />
    <view wx:else class="empty-tip">
      <van-icon name="photograph" size="120rpx" color="#10B981" />
      <text class="tip-text">点击底部按钮拍照或选择相册</text>
      <text class="sub-tip">AI 将自动识别垃圾类别并给出投放建议</text>
    </view>

    <!-- 识别中遮罩 -->
    <van-overlay show="{{ isRecognizing }}" z-index="100">
      <view class="recognizing-box">
        <van-loading type="spinner" color="#10B981" size="60rpx" />
        <text class="recognizing-text">AI 识别中...</text>
      </view>
    </van-overlay>
  </view>

  <!-- 底部悬浮操作按钮 -->
  <view class="float-actions" wx:if="{{ !showResult }}">
    <view class="action-btn album" bindtap="chooseFromAlbum">
      <van-icon name="photo-o" size="48rpx" color="#ffffff" />
      <text>相册</text>
    </view>
    <view class="action-btn camera" bindtap="takePhoto">
      <van-icon name="photograph" size="60rpx" color="#ffffff" />
    </view>
    <view class="action-btn album" bindtap="showHistory">
      <van-icon name="records-o" size="48rpx" color="#ffffff" />
      <text>记录</text>
    </view>
  </view>

  <!-- 识别结果底部弹出面板（v2.1 多目标适配） -->
  <van-action-sheet
    show="{{ showResult }}"
    title="识别结果"
    bind:close="closeResult"
    close-on-click-overlay="{{ true }}"
  >
    <view class="result-panel">
      <!-- 多目标提示 -->
      <view wx:if="{{ result.targetCount > 1 }}" class="multi-target-tip">
        <van-icon name="warning-o" size="24rpx" color="#F59E0B" />
        <text>检测到 {{ result.targetCount }} 个目标，以下为置信度最高项</text>
      </view>

      <!-- 展示图：优先 detectedImage（带框图），点击可放大预览 -->
      <view class="result-image-box" wx:if="{{ result.displayImage }}">
        <image 
          class="result-image" 
          src="{{ result.displayImage }}" 
          mode="aspectFit" 
          bindtap="previewResultImage" 
        />
        <text wx:if="{{ result.detectedImage }}" class="detected-label">AI 检测框（点击放大）</text>
      </view>

      <!-- 分类结果头部 -->
      <view class="result-header">
        <van-tag
          color="{{ result.categoryColor }}"
          text-color="#ffffff"
          size="large"
          custom-class="category-tag"
        >
          {{ result.garbageCategory }}
        </van-tag>
        <text class="sub-category">{{ result.subCategory }}</text>
      </view>

      <!-- 置信度进度条 -->
      <view class="confidence-row">
        <text class="label">识别置信度</text>
        <van-progress
          percentage="{{ result.confidencePercent }}"
          stroke-height="16rpx"
          color="{{ result.categoryColor }}"
          show-pivot="{{ false }}"
        />
        <text class="percent-text">{{ result.confidencePercent }}%</text>
      </view>

      <!-- 投放建议 -->
      <view class="advice-section">
        <view class="section-title">
          <van-icon name="info-o" size="28rpx" color="#10B981" />
          <text>投放建议</text>
        </view>
        <view class="advice-content">
          <text>{{ result.disposalAdvice }}</text>
        </view>
      </view>

      <!-- 操作按钮区 -->
      <view class="result-actions">
        <van-button
          type="default"
          size="small"
          round
          custom-class="action-btn-small"
          bindtap="viewHeatmap"
        >
          <van-icon name="fire-o" size="28rpx" color="#EF4444" />
          查看热力图
        </van-button>
        <van-button
          type="default"
          size="small"
          round
          custom-class="action-btn-small"
          bindtap="goFeedback"
        >
          <van-icon name="question-o" size="28rpx" color="#F59E0B" />
          识别有误
        </van-button>
      </view>
    </view>
  </van-action-sheet>
</view>