/* pages/bind-phone/bind-phone.wxss */
.bind-phone-page {
  min-height: 100vh;
  background-color: #f5f7fa;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}

.bind-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.bind-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-top: 30rpx;
}

.bind-subtitle {
  font-size: 28rpx;
  color: #999999;
  margin-top: 16rpx;
}

.bind-form {
  width: 100%;
}

.bind-btn {
  margin-top: 60rpx !important;
  height: 90rpx !important;
  font-size: 32rpx !important;
}

.skip-btn {
  text-align: center;
  margin-top: 40rpx;
}

.skip-btn text {
  font-size: 28rpx;
  color: #999999;
  text-decoration: underline;
}