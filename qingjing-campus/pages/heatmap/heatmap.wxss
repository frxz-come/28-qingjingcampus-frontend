/* pages/heatmap/heatmap.wxss */
.heatmap-page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 30rpx;
  padding-bottom: 60rpx;
}

/* 图片对比区域 */
.image-compare {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.image-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.image-label {
  font-size: 26rpx;
  color: #666666;
  font-weight: 500;
}

.compare-image {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  background-color: #e0e0e0;
}

.image-placeholder {
  width: 100%;
  height: 300rpx;
  border-radius: 16rpx;
  background-color: #e0e0e0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 说明卡片 */
.explain-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.explain-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.explain-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  display: block;
  margin-bottom: 20rpx;
}

.explain-detail {
  display: flex;
  gap: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.detail-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #666666;
}

.color-block {
  width: 32rpx;
  height: 32rpx;
  border-radius: 6rpx;
}

/* 结果信息 */
.result-info {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 40rpx;
}

.sub-category {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.confidence {
  font-size: 26rpx;
  color: #999999;
}

/* 底部按钮 */
.bottom-actions {
  padding: 0 20rpx;
}