<!-- pages/heatmap/heatmap.wxml -->
<view class="heatmap-page">

<!-- 图片对比区域 -->
<view class="image-compare">
  <!-- 原始图片 -->
  <view class="image-box">
    <text class="image-label">原始图片</text>
    <view class="image-wrap" bindtap="previewImage" data-type="original">
      <image 
        wx:if="{{ originalImage }}" 
        class="compare-image" 
        src="{{ originalImage }}" 
        mode="aspectFit" 
        data-type="original"
        bindload="onImageLoad"
        binderror="onImageError"
      />
      <view wx:else class="image-placeholder">
        <text>图片加载失败</text>
      </view>
      <!-- 加载中 - 四分类轮转 -->
      <view wx:if="{{ imageLoading.original }}" class="image-loading-overlay">
        <view class="loading-circle-small">
          <view class="trash-wrap-small">
            <image class="trash-icon-small icon-1" src="/static/images/loading/recycle.png" mode="aspectFit" />
            <image class="trash-icon-small icon-2" src="/static/images/loading/harmful.png" mode="aspectFit" />
            <image class="trash-icon-small icon-3" src="/static/images/loading/kitchen.png" mode="aspectFit" />
            <image class="trash-icon-small icon-4" src="/static/images/loading/other.png" mode="aspectFit" />
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- AI 关注区域（带检测框） -->
  <view class="image-box">
    <text class="image-label">AI 关注区域</text>
    <view class="image-wrap" bindtap="previewImage" data-type="detected">
      <image 
        wx:if="{{ detectedImage }}" 
        class="compare-image" 
        src="{{ detectedImage }}" 
        mode="aspectFit" 
        data-type="detected"
        bindload="onImageLoad"
        binderror="onImageError"
      />
      <view wx:else class="image-placeholder">
        <text>检测图加载失败</text>
      </view>
      <!-- 加载中 - 四分类轮转 -->
      <view wx:if="{{ imageLoading.detected }}" class="image-loading-overlay">
        <view class="loading-circle-small">
          <view class="trash-wrap-small">
            <image class="trash-icon-small icon-1" src="/static/images/loading/recycle.png" mode="aspectFit" />
            <image class="trash-icon-small icon-2" src="/static/images/loading/harmful.png" mode="aspectFit" />
            <image class="trash-icon-small icon-3" src="/static/images/loading/kitchen.png" mode="aspectFit" />
            <image class="trash-icon-small icon-4" src="/static/images/loading/other.png" mode="aspectFit" />
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 识别结果信息 -->
<view class="result-info-card">
  <view class="result-header">
    <van-tag color="{{ categoryColor }}" text-color="#ffffff" size="large" custom-class="category-tag">{{ category }}</van-tag>
    <text class="sub-category">{{ subCategory }}</text>
  </view>
  <view class="advice-section" wx:if="{{ disposalAdvice }}">
    <view class="advice-title">
      <van-icon name="info-o" size="28rpx" color="#10B981" />
      <text>投放建议</text>
    </view>
    <text class="advice-text">{{ disposalAdvice }}</text>
  </view>
</view>

<!-- 底部按钮 -->
<view class="bottom-actions">
  <van-button type="primary" block round color="#EF4444" bindtap="goBack">
    返回识别结果
  </van-button>
</view>

<!-- ========== 全局加载 - 四分类图标轮播 ========== -->
<view wx:if="{{ loading }}" class="loading-overlay">
  <view class="loading-circle-large">
    <view class="trash-wrap-large">
      <image class="trash-icon-large icon-1" src="/static/images/loading/recycle.png" mode="aspectFit" />
      <image class="trash-icon-large icon-2" src="/static/images/loading/harmful.png" mode="aspectFit" />
      <image class="trash-icon-large icon-3" src="/static/images/loading/kitchen.png" mode="aspectFit" />
      <image class="trash-icon-large icon-4" src="/static/images/loading/other.png" mode="aspectFit" />
    </view>
  </view>
  <text class="loading-text-large">加载中...</text>
</view>
</view>