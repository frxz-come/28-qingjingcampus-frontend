<!-- pages/feedback/feedback.wxml -->
<view class="feedback-page">
  
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">识别反馈</text>
    <text class="page-subtitle">帮助我们改进 AI 识别准确度</text>
  </view>

  <!-- 系统识别结果展示 -->
  <view class="system-result card">
    <text class="section-title">系统识别结果</text>
    <view class="result-row">
      <van-tag color="{{ systemColor }}" text-color="#ffffff" size="large" custom-class="system-tag">
        {{ systemCategory }}
      </van-tag>
      <text class="sub-cat">{{ systemSubCategory }}</text>
    </view>
  </view>

  <!-- 选择正确分类 -->
  <view class="correct-section card">
    <text class="section-title">
      <text class="required">*</text>
      请选择正确分类
    </text>
    <view class="category-grid">
      <view 
        class="cat-item {{ correctCategory === '可回收物' ? 'active' : '' }}"
        bindtap="onCategoryClick"
        data-name="可回收物"
        style="--cat-color: #1E90FF; --cat-bg: {{ correctCategory === '可回收物' ? '#1E90FF' : '#DBEAFE' }}; --cat-text: {{ correctCategory === '可回收物' ? '#fff' : '#1E90FF' }}"
      >
        <text class="cat-icon">♻</text>
        <text class="cat-name">可回收物</text>
      </view>
      <view 
        class="cat-item {{ correctCategory === '有害垃圾' ? 'active' : '' }}"
        bindtap="onCategoryClick"
        data-name="有害垃圾"
        style="--cat-color: #EF4444; --cat-bg: {{ correctCategory === '有害垃圾' ? '#EF4444' : '#FEE2E2' }}; --cat-text: {{ correctCategory === '有害垃圾' ? '#fff' : '#EF4444' }}"
      >
        <text class="cat-icon">☠</text>
        <text class="cat-name">有害垃圾</text>
      </view>
      <view 
        class="cat-item {{ correctCategory === '厨余垃圾' ? 'active' : '' }}"
        bindtap="onCategoryClick"
        data-name="厨余垃圾"
        style="--cat-color: #10B981; --cat-bg: {{ correctCategory === '厨余垃圾' ? '#10B981' : '#D1FAE5' }}; --cat-text: {{ correctCategory === '厨余垃圾' ? '#fff' : '#10B981' }}"
      >
        <text class="cat-icon">🍃</text>
        <text class="cat-name">厨余垃圾</text>
      </view>
      <view 
        class="cat-item {{ correctCategory === '其他垃圾' ? 'active' : '' }}"
        bindtap="onCategoryClick"
        data-name="其他垃圾"
        style="--cat-color: #6B7280; --cat-bg: {{ correctCategory === '其他垃圾' ? '#6B7280' : '#F3F4F6' }}; --cat-text: {{ correctCategory === '其他垃圾' ? '#fff' : '#6B7280' }}"
      >
        <text class="cat-icon">🗑</text>
        <text class="cat-name">其他垃圾</text>
      </view>
    </view>
  </view>

  <!-- 补充说明 -->
  <view class="desc-section card">
    <van-cell-group inset border="{{ false }}">
      <van-field
        label="补充说明"
        type="textarea"
        placeholder="请描述识别错误的原因，帮助我们改进（可选）"
        value="{{ description }}"
        autosize="{{ { maxHeight: 200, minHeight: 120 } }}"
        maxlength="200"
        show-word-limit
        bind:input="onDescriptionInput"
      />
    </van-cell-group>
  </view>

  <!-- 补充图片 -->
  <view class="image-section card">
    <text class="section-title">补充图片（可选）</text>
    <view class="upload-wrap" wx:if="{{ !supplementImage }}">
      <view class="upload-box" bindtap="chooseImage">
        <van-icon name="photograph" size="56rpx" color="#C0C0C0" />
        <text>点击上传图片</text>
      </view>
    </view>
    <view class="image-preview-wrap" wx:else>
      <image class="preview-img" src="{{ supplementImage }}" mode="aspectFill" />
      <view class="delete-btn" bindtap="deleteImage">
        <van-icon name="cross" size="28rpx" color="#fff" />
      </view>
    </view>
  </view>

  <!-- 已提交提示 -->
  <view wx:if="{{ submitted }}" class="submitted-tip card">
    <van-icon name="passed" size="40rpx" color="#10B981" />
    <text>该识别结果已提交过反馈，感谢您的参与</text>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <van-button
      type="primary"
      block
      round
      color="linear-gradient(135deg, #F59E0B 0%, #D97706 100%)"
      bindtap="submitFeedback"
      loading="{{ loading }}"
      disabled="{{ submitted }}"
      custom-class="submit-btn"
    >
      {{ submitted ? '已反馈' : '提交反馈' }}
    </van-button>
  </view>

  <!-- 全局加载 -->
  <view wx:if="{{ loading }}" class="loading-overlay">
    <view class="loading-circle-large">
      <view class="trash-wrap-large">
        <image class="trash-icon-large icon-1" src="/static/images/loading/recycle.png" mode="aspectFit" />
        <image class="trash-icon-large icon-2" src="/static/images/loading/harmful.png" mode="aspectFit" />
        <image class="trash-icon-large icon-3" src="/static/images/loading/kitchen.png" mode="aspectFit" />
        <image class="trash-icon-large icon-4" src="/static/images/loading/other.png" mode="aspectFit" />
      </view>
    </view>
    <text class="loading-text-large">提交中...</text>
  </view>

</view>