/* pages/index/index.wxss */
.scan-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #10B981 0%, #34D399 25%, #6EE7B7 50%, #D1FAE5 75%, #F0FDF4 90%, #ffffff 100%);
  overflow: hidden;
}

.preview-area {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.preview-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  background-color: rgba(0, 0, 0, 0.05);
}

.empty-tip {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #065F46;
  padding: 60rpx;
  text-align: center;
}

.camera-mascot {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  animation: mascotBounce 3s ease-in-out infinite;
}

@keyframes mascotBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15rpx); }
}

.camera-body {
  position: relative;
  width: 160rpx;
  height: 110rpx;
  background: linear-gradient(135deg, #34D399 0%, #10B981 50%, #059669 100%);
  border-radius: 20rpx;
  margin: 0 auto;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3);
}

.camera-lens {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 70rpx;
  height: 70rpx;
  background: linear-gradient(135deg, #6EE7B7 0%, #34D399 100%);
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lens-inner {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #10B981 0%, #047857 100%);
  border-radius: 50%;
  border: 3rpx solid #A7F3D0;
}

.lens-shine {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  width: 12rpx;
  height: 12rpx;
  background: #ffffff;
  border-radius: 50%;
  opacity: 0.8;
}

.camera-flash {
  position: absolute;
  top: -12rpx;
  right: 20rpx;
  width: 24rpx;
  height: 16rpx;
  background: linear-gradient(180deg, #FCD34D 0%, #F59E0B 100%);
  border-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.4);
}

.camera-btn {
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 12rpx;
  background: linear-gradient(180deg, #6EE7B7 0%, #34D399 100%);
  border-radius: 6rpx 6rpx 0 0;
}

.camera-stand {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100rpx;
  height: 30rpx;
}

.stand-leg {
  position: absolute;
  bottom: 0;
  width: 8rpx;
  height: 30rpx;
  background: linear-gradient(180deg, #34D399 0%, #10B981 100%);
  border-radius: 4rpx;
}

.stand-leg.left { left: 20rpx; transform: rotate(-15deg); }
.stand-leg.right { right: 20rpx; transform: rotate(15deg); }

.tip-text {
  font-size: 34rpx;
  margin-top: 30rpx;
  font-weight: 600;
  color: #065F46;
  text-shadow: 0 2rpx 4rpx rgba(255, 255, 255, 0.5);
}

.sub-tip {
  font-size: 26rpx;
  margin-top: 16rpx;
  color: #059669;
  opacity: 0.85;
}

/* ===== 识别中遮罩 - 四分类轮转 ===== */
.recognizing-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  z-index: 100;
}

.loading-circle-large {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 12rpx 48rpx rgba(16, 185, 129, 0.35);
  animation: circleBreathLarge 2s ease-in-out infinite;
}

@keyframes circleBreathLarge {
  0%, 100% { transform: scale(1); box-shadow: 0 12rpx 48rpx rgba(16, 185, 129, 0.35); }
  50% { transform: scale(1.05); box-shadow: 0 16rpx 56rpx rgba(16, 185, 129, 0.5); }
}

.trash-wrap-large {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trash-icon-large {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  opacity: 0;
  animation: iconSwitchLarge 3s ease-in-out infinite;
}

.icon-1 { animation-delay: 0s; }
.icon-2 { animation-delay: 0.75s; }
.icon-3 { animation-delay: 1.5s; }
.icon-4 { animation-delay: 2.25s; }

@keyframes iconSwitchLarge {
  0%   { opacity: 0; transform: scale(0.5) rotate(-10deg); }
  10%  { opacity: 1; transform: scale(1.1) rotate(0deg); }
  20%  { opacity: 1; transform: scale(1) rotate(0deg); }
  30%  { opacity: 0; transform: scale(0.8) rotate(10deg); }
  100% { opacity: 0; transform: scale(0.5) rotate(-10deg); }
}

.loading-text-large {
  font-size: 36rpx;
  color: #059669;
  letter-spacing: 8rpx;
  font-weight: 500;
}

/* ===== 底部按钮 ===== */
.float-actions {
  position: absolute;
  bottom: 100rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 50rpx;
  z-index: 10;
}

.album-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.album-btn text {
  font-size: 24rpx;
  color: #065F46;
  font-weight: 500;
}

.btn-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
}

.album-icon {
  background: linear-gradient(135deg, #FDE68A 0%, #FCD34D 50%, #F59E0B 100%);
}

.album-bg {
  position: relative;
  width: 60rpx;
  height: 50rpx;
  background: #ffffff;
  border-radius: 8rpx;
  overflow: hidden;
}

.album-mountain {
  position: absolute;
  bottom: 0;
  width: 0;
  height: 0;
  border-style: solid;
}

.album-mountain.m1 {
  left: 5rpx;
  border-left-width: 15rpx;
  border-right-width: 15rpx;
  border-bottom-width: 25rpx;
  border-left-color: transparent;
  border-right-color: transparent;
  border-bottom-color: #34D399;
}

.album-mountain.m2 {
  right: 5rpx;
  border-left-width: 12rpx;
  border-right-width: 12rpx;
  border-bottom-width: 20rpx;
  border-left-color: transparent;
  border-right-color: transparent;
  border-bottom-color: #6EE7B7;
}

.album-sun {
  position: absolute;
  top: 8rpx;
  right: 10rpx;
  width: 14rpx;
  height: 14rpx;
  background: #F59E0B;
  border-radius: 50%;
}

.camera {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  box-shadow: 0 8rpx 32rpx rgba(16, 185, 129, 0.4), 0 0 0 6rpx rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: cameraPulse 2s ease-in-out infinite;
}

@keyframes cameraPulse {
  0%, 100% { transform: scale(1); box-shadow: 0 8rpx 32rpx rgba(16, 185, 129, 0.4), 0 0 0 6rpx rgba(255, 255, 255, 0.3); }
  50% { transform: scale(1.05); box-shadow: 0 12rpx 40rpx rgba(16, 185, 129, 0.5), 0 0 0 8rpx rgba(255, 255, 255, 0.4); }
}

.camera-ring {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.camera-center {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #ffffff;
  opacity: 0.9;
}

.record-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.record-btn text {
  font-size: 24rpx;
  color: #065F46;
  font-weight: 500;
}

.record-icon {
  background: linear-gradient(135deg, #93C5FD 0%, #60A5FA 50%, #3B82F6 100%);
}

.record-bg {
  position: relative;
  width: 60rpx;
  height: 50rpx;
}

.record-list {
  position: absolute;
  top: 0;
  left: 0;
  width: 40rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.record-item {
  width: 100%;
  height: 10rpx;
  background: #ffffff;
  border-radius: 4rpx;
}

.record-item.r1 { width: 100%; }
.record-item.r2 { width: 75%; }
.record-item.r3 { width: 50%; }

.record-check {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 24rpx;
  height: 24rpx;
  background: #10B981;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
}

.record-check::after {
  content: '';
  position: absolute;
  top: 4rpx;
  left: 8rpx;
  width: 6rpx;
  height: 10rpx;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(45deg);
}

/* 结果面板 */
.result-panel {
  padding: 30rpx 40rpx 60rpx 40rpx;
  background: #ffffff;
}

.multi-target-tip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #F59E0B;
  margin-bottom: 20rpx;
  padding: 12rpx 16rpx;
  background: #fffbeb;
  border-radius: 12rpx;
}

.result-image-box {
  position: relative;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f7fa;
}

.result-image {
  width: 100%;
  height: 400rpx;
  display: block;
}

.detected-label {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 24rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.5);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.result-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.category-tag {
  padding: 12rpx 24rpx !important;
  font-size: 32rpx !important;
  font-weight: bold !important;
  border-radius: 12rpx !important;
}

.sub-category {
  font-size: 28rpx;
  color: #666666;
}

.advice-section {
  background: #f0fdf4;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #10B981;
  margin-bottom: 16rpx;
}

.advice-content {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
}

.result-actions {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
}

.action-btn-small {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx !important;
  border: 2rpx solid #e5e7eb !important;
}