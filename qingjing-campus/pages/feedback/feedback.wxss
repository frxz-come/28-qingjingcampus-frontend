/* pages/feedback/feedback.wxss */

/* ===== 页面根节点 ===== */
page {
  background: #f5f7fa;
  min-height: 100vh;
}

.feedback-page {
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ===== 通用卡片 ===== */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* ===== 页面标题 ===== */
.page-header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-top: 20rpx;
}

.page-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: #999999;
}

/* ===== 章节标题 ===== */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
  display: block;
}

.required {
  color: #EF4444;
  margin-right: 4rpx;
}

/* ===== 系统识别结果 ===== */
.system-result .result-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.system-tag {
  padding: 12rpx 28rpx !important;
  font-size: 30rpx !important;
  font-weight: bold !important;
  border-radius: 12rpx !important;
}

.sub-cat {
  font-size: 32rpx;
  color: #666666;
  font-weight: 500;
}

/* ===== 分类选择网格 ===== */
.category-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 36rpx 20rpx;
  border-radius: 16rpx;
  background: var(--cat-bg);
  border: 2rpx solid var(--cat-color);
  transition: all 0.2s ease;
}

.cat-item.active {
  transform: scale(1.02);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.cat-icon {
  font-size: 44rpx;
}

.cat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--cat-text);
}

/* ===== 图片上传 ===== */
.upload-wrap {
  width: 100%;
}

.upload-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 80rpx 40rpx;
  border: 2rpx dashed #D1D5DB;
  border-radius: 16rpx;
  background: #F9FAFB;
}

.upload-box text {
  font-size: 28rpx;
  color: #9CA3AF;
}

.image-preview-wrap {
  position: relative;
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
  display: block;
}

.delete-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 52rpx;
  height: 52rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4rpx);
}

/* ===== 已提交提示 ===== */
.submitted-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: #F0FDF4;
  border: 2rpx solid #D1FAE5;
}

.submitted-tip text {
  font-size: 28rpx;
  color: #059669;
}

/* ===== 提交按钮 ===== */
.submit-section {
  margin-top: 40rpx;
}

.submit-btn {
  height: 96rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  box-shadow: 0 6rpx 20rpx rgba(245, 158, 11, 0.3) !important;
}

/* ===== 全局加载 - 四分类图标轮播 ===== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  z-index: 999;
}

.loading-circle-large {
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 12rpx 48rpx rgba(245, 158, 11, 0.35);
  animation: circleBreathLarge 2s ease-in-out infinite;
}

@keyframes circleBreathLarge {
  0%, 100% { transform: scale(1); box-shadow: 0 12rpx 48rpx rgba(245, 158, 11, 0.35); }
  50% { transform: scale(1.05); box-shadow: 0 16rpx 56rpx rgba(245, 158, 11, 0.5); }
}

.trash-wrap-large {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trash-icon-large {
  position: absolute;
  width: 120rpx;
  height: 120rpx;
  opacity: 0;
  animation: iconSwitchLarge 3s ease-in-out infinite;
}

.icon-1 { animation-delay: 0s; }
.icon-2 { animation-delay: 0.75s; }
.icon-3 { animation-delay: 1.5s; }
.icon-4 { animation-delay: 2.25s; }

@keyframes iconSwitchLarge {
  0% { opacity: 0; transform: scale(0.5) rotate(-10deg); }
  10% { opacity: 1; transform: scale(1.1) rotate(0deg); }
  20% { opacity: 1; transform: scale(1) rotate(0deg); }
  30% { opacity: 0; transform: scale(0.8) rotate(10deg); }
  100% { opacity: 0; transform: scale(0.5) rotate(-10deg); }
}

.loading-text-large {
  font-size: 36rpx;
  color: #D97706;
  letter-spacing: 8rpx;
  font-weight: 500;
}